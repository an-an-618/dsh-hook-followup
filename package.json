{
  "name": "@an-an-618/dsh-hook-followup",
  "version": "0.1.0",
  "description": "Hook follow-up for DeepSeek Harness: the model appends one anchor question and 1-3 user-voice quick replies, rendered as clickable chips under the turn and sent back as one ordinary user message.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "follow-up",
    "quick-replies",
    "hook",
    "chat-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/an-an-618/dsh-hook-followup.git"
  },
  "homepage": "https://github.com/an-an-618/dsh-hook-followup#readme",
  "bugs": {
    "url": "https://github.com/an-an-618/dsh-hook-followup/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
